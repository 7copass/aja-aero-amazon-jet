# AJA Aero ERP — copie para .env e preencha.
# No Vercel, cadastre estas variáveis em Settings > Environment Variables.

# Supabase (projeto AJA AERO)
SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# IA — opcional. Sem isso, o Agente de Análise de Dados fica desligado.
# OpenAI:     https://api.openai.com/v1
# Anthropic:  https://api.anthropic.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# AI_API_KEY=""
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"

# Service role — SOMENTE no servidor, nunca com prefixo VITE_.
# SUPABASE_SERVICE_ROLE_KEY=""
